{
  "rules": {
    "meta": {
      ".read": true,
      ".write": false
    },
    "public": {
      ".read": true,
      ".write": false,
      "schedule": {
        ".write": "auth != null"
      },
      "turnoFuturo": {
        ".write": "auth != null"
      }
    },
    "private": {
      "changeRequests": {
        ".read": "auth != null",
        "$requestId": {
          ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))"
        }
      },
      "adminUpdates": {
        ".read": "auth != null",
        ".write": "auth != null",
        "pushQueue": {
          "$id": {
            ".validate": "data.exists() || (newData.child('kind').val() !== 'agent-connection' && newData.child('source').val() !== 'navisuite-connection') || root.child('private/adminUpdates/pushSettings/agentConnectionAlerts').val() !== false"
          }
        }
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    },
    "config": {
      ".read": false,
      ".write": false
    }
  }
}
