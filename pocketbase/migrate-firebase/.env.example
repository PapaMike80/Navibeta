# Source: prefer an offline Firebase JSON export for the first rehearsals.
FIREBASE_EXPORT_FILE=/absolute/path/firebase-export.json
# Optional live READ-ONLY source. The migrator never sends writes to Firebase.
# FIREBASE_DATABASE_URL=https://PROJECT-default-rtdb.REGION.firebasedatabase.app
# FIREBASE_AUTH_TOKEN=

# Target. Required only with the explicit --execute flag.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

MIGRATION_CHECKPOINT_FILE=./migration-checkpoint.json
