const NAVI=Object.freeze({databaseUrl:'https://navisuite-f116f-default-rtdb.europe-west1.firebasedatabase.app',publicScheduleUrl:'https://navisuite-f116f-default-rtdb.europe-west1.firebasedatabase.app/public/schedule.json',tokenProperty:'NAVISUITE_CALENDAR_TOKENS_V1',authProperty:'NAVISUITE_FIREBASE_AUTH_V1',apiKeyProperty:'NAVISUITE_FIREBASE_API_KEY',timezone:'Europe/Rome'});

// Orari di presenza/servizio: inizio = partenza prima corsa del turno - 60'
// di presentazione a bordo, fine = arrivo ultima corsa (invariato). Ricavati
// dalla tabella corse ufficiale (assets/js/orario-main.js) con
// tools/generate-shift-times.py — vedi assets/shift-times.json, stessa fonte
// usata dal generatore .ics lato client (assets/js/calendar-settings-v2.js).
// BIS/DT/POND non sono nella tabella corse attuale: orari storici, tenuti
// cosi' come sono finche' non si conferma il codice corrispondente aggiornato.
// T1/T2: orari dall'ufficio (prima partenza 08:10/08:45 - 60').
// I servizi senza un orario verificato restano volutamente "tutto il giorno".
// Versione mostrata aprendo l'URL /exec senza token: serve a verificare che
// il deployment attivo sia davvero quello aggiornato.
const FEED_VERSION='v6 orario invernale';

const SERVICE_TIMES=Object.freeze({
  D1:['07:55','20:15'],D2:['07:20','18:25'],D3:['07:00','19:20'],D4:['07:15','19:45'],
  M1:['07:20','19:50'],T1:['07:10','18:30'],T2:['07:45','16:10'],R1:['07:50','20:05'],R2:['07:00','19:30'],R3:['07:40','19:20'],R4:['08:20','20:30'],
  CAR1:['07:20','19:40'],CAP1:['07:30','19:35'],SR1:['07:50','19:30'],
  P1:['08:10','20:10'],P2:['07:00','19:20'],P3:['07:35','19:00'],
  BIS:['08:00','19:15'],DT:['06:55','17:15'],POND:['09:10','20:25']
});

// Orario invernale (O.d.S. n. 39/2026, orari pag. 15-17 e servizi di terra
// pag. 19): prima partenza - 60' / ultimo arrivo; i servizi di terra con il
// loro orario. Si applicano, in ordine, i set con decorrenza <= giorno.
const SERVICE_TIMES_SETS=[
  {from:'2026-10-05',times:{D1:['08:15','19:40'],D2:['07:50','19:00'],BIS:['07:30','18:40'],T1:['07:10','18:30'],T2:['07:45','19:10'],M1:['08:15','19:25'],
    R1:['07:45','19:25'],R2:['07:10','18:50'],R3:['08:40','17:40'],P1:['08:10','19:30'],P2:['07:25','18:35'],SR1:['08:00','18:30'],SR2:['07:40','18:55'],
    AGB:['08:00','17:30'],POND:['09:30','19:50'],AGM:['09:00','19:30'],AGT:['07:50','18:20'],AGT1:['07:50','18:20'],AGT2:['07:50','18:20']}},
  {from:'2026-11-02',times:{AGT:['07:55','18:50'],AGT1:['07:55','18:50'],AGT2:['07:55','18:50']}},
  {from:'2027-03-13',times:{AGT:['07:50','18:20'],AGT1:['07:50','18:20'],AGT2:['07:50','18:20']}}
];
function serviceTimesFor_(iso){const table=Object.assign({},SERVICE_TIMES);SERVICE_TIMES_SETS.forEach(set=>{if(String(iso||'')>=set.from)Object.assign(table,set.times)});return table}

function doGet(e){const token=String(e?.parameter?.token||'').trim();if(!/^[a-f0-9]{64}$/i.test(token))return text_('Calendario NaviSuite: link non valido. Versione feed: '+FEED_VERSION+'.');const record=readTokens_()[token];if(!record?.agentId)return text_('Calendario NaviSuite: link revocato o non valido.');try{return ContentService.createTextOutput(buildCalendar_(String(record.agentId))).setMimeType(ContentService.MimeType.ICAL)}catch(error){console.error(error);return text_('Calendario NaviSuite temporaneamente non disponibile.')}}
function doPost(e){const p=e?.parameter||{},requestId=String(p.requestId||'').trim(),action=String(p.action||'').trim().toLowerCase(),agentId=String(p.agentId||'').trim(),token=String(p.token||'').trim().toLowerCase(),proof=String(p.proof||'').trim().toLowerCase();let result;try{if(!agentId||!/^[a-f0-9]{64}$/.test(proof))throw new Error('Credenziali non valide');if(!verifyUser_(agentId,proof))throw new Error('PIN non valido');const tokens=readTokens_();if(action==='register'){if(!/^[a-f0-9]{64}$/.test(token))throw new Error('Token non valido');tokens[token]={agentId,createdAt:new Date().toISOString()};writeTokens_(tokens);result={ok:true,action:'register'}}else if(action==='revoke'){if(tokens[token]&&String(tokens[token].agentId)===agentId)delete tokens[token];writeTokens_(tokens);result={ok:true,action:'revoke'}}else throw new Error('Azione non supportata')}catch(error){result={ok:false,error:String(error?.message||error)}}return postResult_(requestId,result)}
function postResult_(requestId,result){const payload=JSON.stringify(Object.assign({source:'navisuite-calendar',requestId:String(requestId||'')},result||{})).replace(/<\//g,'<\\/');return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><script>parent.postMessage('+payload+',"*");<\/script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function apiKey_(){const value=String(PropertiesService.getScriptProperties().getProperty(NAVI.apiKeyProperty)||'').trim();if(!value)throw new Error('Firebase API key non configurata nelle Script Properties');return value}
function text_(v){return ContentService.createTextOutput(String(v||'')).setMimeType(ContentService.MimeType.TEXT)}
function readTokens_(){try{return JSON.parse(PropertiesService.getScriptProperties().getProperty(NAVI.tokenProperty)||'{}')||{}}catch(_){return{}}}
function writeTokens_(v){PropertiesService.getScriptProperties().setProperty(NAVI.tokenProperty,JSON.stringify(v||{}))}
function safeKey_(v){return String(v||'').trim().replace(/[.#$\[\]\/]/g,'_')}
function verifyUser_(id,proof){const saved=firebaseGet_('private/adminUpdates/userAuth/'+encodeURIComponent(safeKey_(id)))||{};return String(saved.pinHash||'').toLowerCase()===String(proof||'').toLowerCase()}
function firebaseGet_(path){const auth=firebaseAuth_(),url=NAVI.databaseUrl+'/'+String(path||'').replace(/^\/+/, '')+'.json?auth='+encodeURIComponent(auth.idToken),response=UrlFetchApp.fetch(url,{muteHttpExceptions:true,headers:{Accept:'application/json'}});if(response.getResponseCode()<200||response.getResponseCode()>=300)throw new Error('Firebase HTTP '+response.getResponseCode());const text=response.getContentText();return text?JSON.parse(text):null}
function firebaseAuth_(){const props=PropertiesService.getScriptProperties();let auth=null;try{auth=JSON.parse(props.getProperty(NAVI.authProperty)||'null')}catch(_){}if(auth?.idToken&&Number(auth.expiresAt||0)>Date.now()+120000)return auth;if(auth?.refreshToken){try{const response=UrlFetchApp.fetch('https://securetoken.googleapis.com/v1/token?key='+encodeURIComponent(apiKey_()),{method:'post',muteHttpExceptions:true,contentType:'application/x-www-form-urlencoded',payload:{grant_type:'refresh_token',refresh_token:auth.refreshToken}}),data=JSON.parse(response.getContentText()||'{}');if(response.getResponseCode()>=200&&response.getResponseCode()<300&&data.id_token){auth={uid:data.user_id,idToken:data.id_token,refreshToken:data.refresh_token,expiresAt:Date.now()+Number(data.expires_in||3600)*1000};props.setProperty(NAVI.authProperty,JSON.stringify(auth));return auth}}catch(_){}}const response=UrlFetchApp.fetch('https://identitytoolkit.googleapis.com/v1/accounts:signUp?key='+encodeURIComponent(apiKey_()),{method:'post',muteHttpExceptions:true,contentType:'application/json',payload:JSON.stringify({returnSecureToken:true})}),data=JSON.parse(response.getContentText()||'{}');if(response.getResponseCode()<200||response.getResponseCode()>=300||!data.idToken)throw new Error('Autenticazione Firebase non riuscita');auth={uid:data.localId,idToken:data.idToken,refreshToken:data.refreshToken,expiresAt:Date.now()+Number(data.expiresIn||3600)*1000};props.setProperty(NAVI.authProperty,JSON.stringify(auth));return auth}
function publicSchedule_(){const response=UrlFetchApp.fetch(NAVI.publicScheduleUrl+'?t='+Date.now(),{muteHttpExceptions:true,headers:{Accept:'application/json'}});if(response.getResponseCode()<200||response.getResponseCode()>=300)throw new Error('Turni non disponibili');return JSON.parse(response.getContentText()||'{}')||{}}
function norm_(v){return String(v||'').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Z0-9]+/g,' ').trim()}
function stableUid_(v){const n=norm_(v).replace(/\s+/g,'_');return n?'AG_'+n:''}
function normalizedShift_(v){const raw=String(v??'').trim().toUpperCase().replace(/[‐‑–—]/g,'-');if(!raw||/^(?:RIP(?:\.|-*)?|RIPOSO|-{2,}|={2,})$/.test(raw))return'RIP';if(/^(?:CONG?\.?|CON;|CONC\.?|C\.)$/.test(raw))return'CON';if(/^(?:LAV\.?|TERRA)$/.test(raw))return'TERRA';if(/^F\.?P\.?-*$/.test(raw))return'F.P.';return raw.replace(/\.{2,}$/g,'.').replace(/-+$/g,'')}
function courseShift_(v){const raw=String(v||'').trim().toUpperCase().replace(/[‐‑–—]/g,'-').replace(/\s+/g,''),m=raw.match(/^C?(D[1-4]|BIS|T[12]|M1|R[1-4]|CAR\d*|P[1-3]|CAP\d*|SR1)C?$/);if(!m)return'';const direct=m[1],code=direct.replace(/\d+$/,'');return code==='CAR'||code==='CAP'?code:direct}
function isWorking_(v){const s=normalizedShift_(v);return Boolean(s)&&!/^(?:RIP|RIPOSO|CON|CONG|CONGEDO|FERIE|MAL|MALATTIA|F\.P\.|FP|===|--+)$/i.test(s)}
function values_(v){if(Array.isArray(v))return v.filter(Boolean);if(!v||typeof v!=='object')return[];return Object.keys(v).map(k=>v[k]).filter(Boolean)}
function flatten_(data){const result=[],seen={};Object.keys(data.residenze||{}).forEach(residence=>(data.residenze[residence]||[]).forEach(agent=>{const key=String(agent.agent_uid||agent.id||stableUid_(agent.agente));if(!key||seen[key])return;seen[key]=true;const copy=JSON.parse(JSON.stringify(agent||{}));copy.__residence=residence;result.push(copy)}));return result}
function applyImports_(data,imports){const active=values_(imports).filter(x=>x&&x.attiva!==false).sort((a,b)=>String(a.importedAt||'').localeCompare(String(b.importedAt||'')));active.forEach(batch=>{const dates=Array.isArray(batch.dates)?batch.dates:[];values_(batch.rows).forEach(row=>{const agents=flatten_(data),uid=String(row.agent_uid||stableUid_(row.agente)),name=norm_(row.agente),target=agents.find(a=>String(a.agent_uid||stableUid_(a.agente))===uid)||(name?agents.find(a=>norm_(a.agente)===name):null)||agents.find(a=>String(a.id||'')===String(row.id_agente||''));if(!target)return;Object.keys(data.residenze||{}).some(res=>{const original=(data.residenze[res]||[]).find(a=>String(a.id||'')===String(target.id||'')||norm_(a.agente)===norm_(target.agente));if(!original)return false;original.turni=original.turni||{};dates.forEach((iso,i)=>original.turni[iso]=normalizedShift_((row.turni||[])[i]));return true})})})}
function applyProfiles_(data,profiles){data.residenze=data.residenze||{};values_(profiles).forEach(item=>{if(!item||!String(item.id||'').trim()||!String(item.residence||'').trim())return;const residence=String(item.residence).trim(),list=data.residenze[residence]=data.residenze[residence]||[];if(!list.some(a=>String(a.id||'')===String(item.id)))list.push({agente:String(item.name||item.id),id:String(item.id),qualifica:String(item.qualifica||''),role:String(item.role||''),turni:{},turni_settimanali:{}})})}
function mergeData_(){const data=publicSchedule_();let updates={};try{updates=firebaseGet_('private/adminUpdates')||{}}catch(_){updates={}}applyImports_(data,updates.scheduleImports);applyProfiles_(data,updates.agentProfiles||{});data.variazioni_ods=values_(updates.odsVariations).concat(values_(updates.manualVariations));const rows=values_(data.turni_navi).concat(values_(updates.turniNavi)),byKey={};rows.forEach(item=>{if(!item)return;byKey[String(item.data||'')+'|'+String(item.corsa||item.turno||'')+'|'+String(item.nave||'')]=item});data.turni_navi=values_(byKey);return data}
function variationMap_(data){const map={};values_(data.variazioni_ods).forEach(item=>{if(!item||item.attiva===false)return;const iso=String(item.data||item.date||'').slice(0,10);if(!/^\d{4}-\d{2}-\d{2}$/.test(iso))return;const shift=item.turno_nuovo??item.turno??item.dopo;if(shift==null)return;if(item.id_agente||item.agentId)map['id:'+String(item.id_agente||item.agentId)+'|'+iso]=shift;if(item.agente||item.nome)map['name:'+norm_(item.agente||item.nome)+'|'+iso]=shift});return map}
function effective_(agent,iso,map){const id=String(agent.id||agent.agent_uid||''),changed=map['id:'+id+'|'+iso],named=map['name:'+norm_(agent.agente||agent.name)+'|'+iso];return normalizedShift_(changed!=null?changed:(named!=null?named:(agent.turni||{})[iso]))}
function ship_(data,iso,shift){const course=courseShift_(shift);if(!course)return null;return values_(data.turni_navi).find(item=>item&&item.attiva!==false&&String(item.data||'').slice(0,10)===iso&&courseShift_(item.corsa||item.turno)===course)||null}
function role_(a){const v=String(a.qualifica||a.grado||a.role||'');if(/capitano|comandante/i.test(v))return{label:'Capitano',rank:10};if(/capo\s*timoniere|capotimoniere/i.test(v))return{label:'Capo timoniere',rank:20};if(/aiuto\s*motorista|aiutomotorista/i.test(v))return{label:'Aiuto motorista',rank:40};if(/motorista/i.test(v))return{label:'Motorista',rank:30};if(/timoniere/i.test(v))return{label:'Timoniere',rank:50};if(/marinaio/i.test(v))return{label:'Marinaio',rank:60};if(/barista/i.test(v))return{label:'Barista',rank:70};return{label:v||'Equipaggio',rank:99}}
function crew_(data,iso,shift,map){const course=courseShift_(shift);if(!course)return[];return flatten_(data).filter(a=>courseShift_(effective_(a,iso,map))===course).map(a=>({a,meta:role_(a)})).sort((x,y)=>x.meta.rank-y.meta.rank||String(x.a.agente||x.a.name||'').localeCompare(String(y.a.agente||y.a.name||''),'it')).map(x=>String(x.a.agente||x.a.name||'').trim()+' ('+x.meta.label+')')}
function refuel_(ship){const value=ship?.rifornimento_mattina??ship?.rifornimento??ship?.rifornimentoMattina??'';if(value===true)return'Sì';if(value===false||value===null||value===undefined)return'';const text=String(value).trim();if(!text)return'';if(/^(?:1|true|si|sì|yes)$/i.test(text))return'Sì';if(/^(?:0|false|no)$/i.test(text))return'';return text}
// Chiave orario: toglie asterisco (sovrannumero) e segni finali, riconosce la
// trasferta CxxC (stesso orario del turno base) e CAR/CAP -> CAR1/CAP1.
function serviceTimeKey_(shift,table=SERVICE_TIMES){let key=normalizedShift_(shift).replace(/\s+/g,'').replace(/[^A-Z0-9]+$/,'');if(!table[key]&&/^C.+C$/.test(key)&&key.length>2)key=key.slice(1,-1);if(key==='CAR'||key==='CAP')key+='1';return key}
function serviceTime_(shift,iso){const table=serviceTimesFor_(iso);return table[serviceTimeKey_(shift,table)]||null}
function localDateTime_(iso,hhmm){return iso.replace(/-/g,'')+'T'+String(hhmm).replace(':','')+'00'}
// Orari in UTC (suffisso Z): nessuna dipendenza da TZID/VTIMEZONE, letti
// uguali da iPhone, Google e Outlook. L'offset di Roma (CET/CEST) e' quello
// valido in quella data.
function utcStamp_(iso,hhmm){const d=iso.split('-').map(Number),t=String(hhmm).split(':').map(Number);let ms=Date.UTC(d[0],d[1]-1,d[2],t[0],t[1]);const off=Utilities.formatDate(new Date(ms),NAVI.timezone,'Z'),m=/^([+-])(\d{2})(\d{2})$/.exec(off);if(m)ms-=(m[1]==='-'?-1:1)*(Number(m[2])*60+Number(m[3]))*60000;return Utilities.formatDate(new Date(ms),'UTC',"yyyyMMdd'T'HHmmss'Z'")}
function eventTimeLines_(iso,shift){const times=serviceTime_(shift,iso);if(!times)return['DTSTART;VALUE=DATE:'+iso.replace(/-/g,''),'DTEND;VALUE=DATE:'+next_(iso).replace(/-/g,'')];return['DTSTART:'+utcStamp_(iso,times[0]),'DTEND:'+utcStamp_(iso,times[1])]}
function buildCalendar_(agentId){const data=mergeData_(),agents=flatten_(data),agent=agents.find(a=>String(a.id||'')===String(agentId));if(!agent)throw new Error('Agente non trovato');const map=variationMap_(data),dates={};values_(data.date).forEach(item=>{const iso=String(item.iso||'');if(/^\d{4}-\d{2}-\d{2}$/.test(iso))dates[iso]=true});Object.keys(agent.turni||{}).forEach(iso=>{if(/^\d{4}-\d{2}-\d{2}$/.test(iso))dates[iso]=true});const stamp=Utilities.formatDate(new Date(),'UTC',"yyyyMMdd'T'HHmmss'Z'"),name=String(agent.agente||agent.name||agentId).trim(),lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//NaviSuite//Calendario personale '+FEED_VERSION+'//IT','CALSCALE:GREGORIAN','METHOD:PUBLISH','X-WR-CALNAME:'+esc_('NaviSuite - '+name),'X-WR-TIMEZONE:'+NAVI.timezone,'REFRESH-INTERVAL;VALUE=DURATION:PT1H','X-PUBLISHED-TTL:PT1H','BEGIN:VTIMEZONE','TZID:'+NAVI.timezone,'BEGIN:DAYLIGHT','TZOFFSETFROM:+0100','TZOFFSETTO:+0200','TZNAME:CEST','DTSTART:19700329T020000','RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU','END:DAYLIGHT','BEGIN:STANDARD','TZOFFSETFROM:+0200','TZOFFSETTO:+0100','TZNAME:CET','DTSTART:19701025T030000','RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU','END:STANDARD','END:VTIMEZONE'];Object.keys(dates).sort().forEach(iso=>{const shift=effective_(agent,iso,map);if(!isWorking_(shift))return;const s=ship_(data,iso,shift),vessel=String(s?.nave||s?.nome_nave||'').trim(),description=['Servizio: '+shift];const times=serviceTime_(shift,iso);if(times)description.push('Orario: '+times[0]+'–'+times[1]);if(vessel)description.push('Nave: '+vessel);const berth=String(s?.ormeggio_serale||s?.ormeggio||s?.ormeggioSera||'').trim();if(berth)description.push('Ormeggio serale: '+berth);const refuel=refuel_(s);if(refuel)description.push('Rifornimento: '+refuel);const crew=crew_(data,iso,shift,map);if(crew.length)description.push('','Equipaggio:');crew.forEach(person=>description.push('• '+person));description.push('','Generato da NaviSuite');lines.push('BEGIN:VEVENT','UID:'+String(agentId).replace(/[^A-Za-z0-9_-]/g,'_')+'-'+iso+'@navisuite','DTSTAMP:'+stamp,...eventTimeLines_(iso,shift),'SUMMARY:'+esc_((times?times[0]+' ':'NaviSuite · ')+shift+(vessel?' · '+vessel:'')),'DESCRIPTION:'+esc_(description.join('\n')),'STATUS:CONFIRMED','TRANSP:TRANSPARENT','END:VEVENT')});lines.push('END:VCALENDAR');return lines.map(fold_).join('\r\n')+'\r\n'}
function next_(iso){const p=iso.split('-').map(Number),d=new Date(Date.UTC(p[0],p[1]-1,p[2]+1,12));return Utilities.formatDate(d,'UTC','yyyy-MM-dd')}
function esc_(v){return String(v??'').replace(/\\/g,'\\\\').replace(/\r?\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;')}
function fold_(line){const chunks=[];let rest=String(line||'');while(rest.length>72){chunks.push(rest.slice(0,72));rest=rest.slice(72)}chunks.push(rest);return chunks.join('\r\n ')}
